<script>
const seciliFormat = { format: null, kalite: null, tur: null };
const MAKS_TOPLU_VIDEO = 20;
let analizVeri = null;
let aramaSecilen = false;
let oynatmaModu = false;
let oynatmaVeri = null;
let duzenlemeAktif = false;
let duzenlemeOnizlemeId = null;
let duzenlemeUrl = '';
let duzenlemeSure = 0;
let duzenlemeBaslangic = 0;
let duzenlemeBitis = 0;
let kareGuncellemeZamani = null;
let kareGuncellemeSayaci = 0;

const AYDINLIK_LOGO = 'https://cdn-icons-png.flaticon.com/128/12180/12180724.png';
const KARANLIK_LOGO = 'https://cdn-icons-png.flaticon.com/128/2693/2693357.png';

// PWA Service Worker Kaydı (PWA Desteği için)
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  });
}

function sssModalAc(tip) {
  if (tip === 'kayit') document.getElementById('modalKayit').classList.add('aktif');
  if (tip === 'platform') document.getElementById('modalPlatform').classList.add('aktif');
  if (tip === 'kaynaklar') document.getElementById('modalKaynaklar').classList.add('aktif');
  document.body.style.overflow = 'hidden';
}

function sssModalKapat(tip) {
  if (tip === 'kayit') document.getElementById('modalKayit').classList.remove('aktif');
  if (tip === 'platform') document.getElementById('modalPlatform').classList.remove('aktif');
  if (tip === 'kaynaklar') document.getElementById('modalKaynaklar').classList.remove('aktif');
  document.body.style.overflow = '';
}

function indirmeIlerlemesiGoster(metin, yuzdeDegeri = 0, durum = 'aktif') {
  const alan = document.getElementById('indirmeIlerleme');
  const yazi = document.getElementById('indirmeIlerlemeMetni');
  const yuzde = document.getElementById('indirmeIlerlemeYuzde');
  const dolgu = document.getElementById('indirmeDolgu');
  const cubuk = alan?.querySelector('[role="progressbar"]');
  if (!alan) return;

  alan.hidden = false;
  alan.classList.remove('tamamlandi', 'hata');

  let yuzdeSayi = Math.max(0, Math.min(100, Number(yuzdeDegeri) || 0));

  if (durum === 'tamamlandi') {
    alan.classList.add('tamamlandi');
    yuzdeSayi = 100;
    yuzde.textContent = '%100';
    cubuk?.setAttribute('aria-valuenow', '100');
    cubuk?.setAttribute('aria-valuetext', '%100 indirildi');
  } else if (durum === 'hata') {
    alan.classList.add('hata');
    yuzde.textContent = 'Başarısız';
    cubuk?.setAttribute('aria-valuetext', 'İndirme başarısız');
  } else {
    yuzde.textContent = `%${yuzdeSayi}`;
    cubuk?.setAttribute('aria-valuenow', String(yuzdeSayi));
    cubuk?.setAttribute('aria-valuetext', `%${yuzdeSayi} indirildi`);
  }

  if (dolgu) dolgu.style.width = `${yuzdeSayi}%`;
  if (yazi) yazi.textContent = metin;
}

function indirmeIlerlemesiSifirla() {
  const alan = document.getElementById('indirmeIlerleme');
  const dolgu = document.getElementById('indirmeDolgu');
  if (!alan) return;
  alan.hidden = true;
  alan.classList.remove('tamamlandi', 'hata');
  if (dolgu) dolgu.style.width = '0%';
}

function temaToggle() {
  const html = document.documentElement;
  const yeni = html.dataset.tema === 'karanlik' ? 'aydinlik' : 'karanlik';
  html.dataset.tema = yeni;
  
  const temaBtn = document.getElementById('temaDugmesi');
  if (temaBtn) {
    temaBtn.innerHTML = `<img src="${yeni === 'karanlik' ? KARANLIK_LOGO : AYDINLIK_LOGO}" alt="Tema İkonu">`;
  }
  
  localStorage.setItem('tema', yeni);
}

(function() {
  const k = localStorage.getItem('tema');
  if (k) {
    document.documentElement.dataset.tema = k;
    document.addEventListener('DOMContentLoaded', () => {
      const temaBtn = document.getElementById('temaDugmesi');
      if (temaBtn) {
        temaBtn.innerHTML = `<img src="${k === 'karanlik' ? KARANLIK_LOGO : AYDINLIK_LOGO}" alt="Tema İkonu">`;
      }
    });
  }
})();

function mesajGoster(tip, metin) {
  const k = document.getElementById('mesajKutusu');
  k.className = 'mesaj-kutusu aktif ' + tip;
  k.textContent = metin;
}

function mesajGizle() {
  document.getElementById('mesajKutusu').className = 'mesaj-kutusu';
}

function sekmeDegistir(mod) {
  const baglanti = mod === 'baglanti';
  document.getElementById('baglantiSekmesi').classList.toggle('aktif', baglanti);
  document.getElementById('aramaSekmesi').classList.toggle('aktif', !baglanti);
  document.getElementById('baglantiSekmesi').setAttribute('aria-selected', baglanti ? 'true' : 'false');
  document.getElementById('aramaSekmesi').setAttribute('aria-selected', baglanti ? 'false' : 'true');
  document.getElementById('baglantiPanel').hidden = !baglanti;
  document.getElementById('aramaPanel').classList.toggle('aktif', !baglanti);
  if (!aramaSecilen) document.getElementById('sonucAlani').classList.remove('aktif');
  mesajGizle();
}

function sureMetni(saniye) {
  const sn = Number(saniye || 0);
  if (!sn) return '';
  return Math.floor(sn / 60) + ':' + String(sn % 60).padStart(2, '0');
}

function tarihMetni(tarih) {
  if (!/^\d{8}$/.test(tarih || '')) return '';
  return tarih.slice(0, 4) + '-' + tarih.slice(4, 6) + '-' + tarih.slice(6, 8);
}

function aramaSonuclariniGoster(sonuclar) {
  const alan = document.getElementById('aramaSonuclari');
  if (!sonuclar.length) {
    alan.innerHTML = '<div class="arama-bos">Bu arama için video bulunamadı.</div>';
    return;
  }
  alan.innerHTML = sonuclar.map((sonuc, index) => `
    <div class="arama-sonucu">
      <img src="${escHtml(sonuc.kucukResim)}" alt="" loading="lazy">
      <div class="arama-sonucu-bilgi">
        <div class="arama-sonucu-baslik">${escHtml(sonuc.baslik)}</div>
        <div class="arama-sonucu-meta">
          ${sonuc.kanal ? `<span>${escHtml(sonuc.kanal)}</span>` : ''}
          ${sureMetni(sonuc.sure) ? `<span>${sureMetni(sonuc.sure)}</span>` : ''}
          ${tarihMetni(sonuc.yayinTarihi) ? `<span>${tarihMetni(sonuc.yayinTarihi)}</span>` : ''}
        </div>
      </div>
      <button class="arama-sonucu-sec" type="button" data-arama-index="${index}">Seç</button>
    </div>`).join('');
  alan.querySelectorAll('[data-arama-index]').forEach(btn => {
    btn.addEventListener('click', () => youtubeSonucuSec(sonuclar[Number(btn.dataset.aramaIndex)]));
  });
}

async function aramaBaslat() {
  const sorgu = document.getElementById('aramaGiris').value.trim();
  if (!sorgu) return mesajGoster('hata', 'Lütfen bir arama yazın.');
  const btn = document.getElementById('aramaBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="yukleniyor"></span>';
  mesajGizle();
  document.getElementById('aramaSonuclari').innerHTML = '<div class="arama-bos">YouTube aranıyor...</div>';
  try {
    const yanit = await fetch('/indir/ara', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sorgu })
    });
    const veri = await yanit.json();
    if (!veri.basari) {
      document.getElementById('aramaSonuclari').innerHTML = '';
      mesajGoster('hata', veri.mesaj || 'Arama başarısız.');
    } else {
      aramaSonuclariniGoster(veri.sonuclar || []);
    }
  } catch {
    document.getElementById('aramaSonuclari').innerHTML = '';
    mesajGoster('hata', 'Sunucu ile bağlantı kurulamadı.');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Ara';
  }
}

function youtubeSonucuSec(sonuc) {
  if (!sonuc || !sonuc.url) return;
  aramaSecilen = true;
  document.getElementById('urlGiris').value = sonuc.url;
  document.getElementById('aramaGeri').hidden = false;
  sekmeDegistir('baglanti');
  analizBaslat();
}

function aramaSonuclarinaDon() {
  aramaSecilen = false;
  document.getElementById('sonucAlani').classList.remove('aktif');
  sekmeDegistir('arama');
}

function oynatmaListesiGoster(veri) {
  const panel = document.getElementById('oynatmaPanel');
  const alan = document.getElementById('oynatmaListesi');
  const maks = Number(veri.maksTopluVideo) || MAKS_TOPLU_VIDEO;
  panel.hidden = false;
  alan.innerHTML = (veri.oynatmaListesi || []).map((video, index) => `
    <label class="oynatma-satir">
      <input type="checkbox" data-oynatma-index="${index}"${index < maks ? ' checked' : ''}>
      <img src="${escHtml(video.kucukResim)}" alt="" loading="lazy">
      <span class="oynatma-satir-bilgi">
        <span class="oynatma-satir-baslik">${escHtml(video.baslik)}</span>
        <span class="oynatma-satir-meta">${video.kanal ? escHtml(video.kanal) : ''}${sureMetni(video.sure) ? ` · ${sureMetni(video.sure)}` : ''}</span>
      </span>
    </label>`).join('');
  alan.querySelectorAll('[data-oynatma-index]').forEach(input => {
    input.addEventListener('change', event => oynatmaSecimGuncelle(event));
  });
  oynatmaSecimGuncelle();
}

function oynatmaSecimGuncelle(degisim) {
  const kutular = [...document.querySelectorAll('#oynatmaListesi input[data-oynatma-index]')];
  const maks = Number(oynatmaVeri?.maksTopluVideo) || MAKS_TOPLU_VIDEO;
  const seciliKutular = kutular.filter(kutu => kutu.checked);
  if (seciliKutular.length > maks && degisim?.target?.checked) {
    degisim.target.checked = false;
    mesajGoster('bilgi', `En fazla ${maks} video seçebilirsiniz.`);
  }
  const secili = kutular.filter(kutu => kutu.checked).length;
  const toplam = document.querySelectorAll('#oynatmaListesi input[data-oynatma-index]').length;
  document.getElementById('oynatmaSayac').textContent = `${secili} / ${toplam} video seçildi · En fazla ${maks}`;
  document.getElementById('oynatmaTumunuSec').textContent = secili
    ? (secili === toplam ? 'Tümünü kaldır' : 'Seçimi kaldır')
    : `İlk ${Math.min(maks, toplam)} videoyu seç`;
}

function oynatmaTumunuDegistir() {
  const kutular = [...document.querySelectorAll('#oynatmaListesi input[data-oynatma-index]')];
  const herhangiSecili = kutular.some(kutu => kutu.checked);
  const maks = Number(oynatmaVeri?.maksTopluVideo) || MAKS_TOPLU_VIDEO;
  kutular.forEach((kutu, index) => { kutu.checked = !herhangiSecili && index < maks; });
  oynatmaSecimGuncelle();
}

function seciliOynatmaVideolari() {
  if (!oynatmaVeri) return [];
  return [...document.querySelectorAll('#oynatmaListesi input[data-oynatma-index]:checked')]
    .map(input => oynatmaVeri.oynatmaListesi[Number(input.dataset.oynatmaIndex)])
    .filter(Boolean);
}

async function oynatmaFormatlariniAl(url) {
  const yanit = await fetch('/indir/analiz', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ url })
  });
  const veri = await yanit.json();
  if (!veri.basari) throw new Error(veri.mesaj || 'Formatlar alinamadi');
  analizVeri = veri.veri;
  if (!Array.isArray(veri.veri.formatlar) || !veri.veri.formatlar.length) throw new Error('Formatlar alinamadi');
  goruntuleFormatlar(veri.veri.formatlar);
}

function varsayilanFormatlariGoster() {
  goruntuleFormatlar([
    { tur: 'video', kalite: '360p' },
    { tur: 'video', kalite: '480p' },
    { tur: 'video', kalite: '720p' },
    { tur: 'video', kalite: '1080p' },
    { tur: 'ses', format: 'mp3' },
    { tur: 'ses', format: 'wav' }
  ]);
}

function zamanMetni(saniye) {
  const toplam = Math.max(0, Math.round(Number(saniye) || 0));
  const saat = Math.floor(toplam / 3600);
  const dakika = Math.floor((toplam % 3600) / 60);
  const saniyeKismi = toplam % 60;
  return `${saat ? String(saat).padStart(2, '0') + ':' : ''}${String(dakika).padStart(2, '0')}:${String(saniyeKismi).padStart(2, '0')}`;
}

function zamanSayisi(deger) {
  const parcalar = String(deger || '').trim().split(':').map(Number);
  if (!parcalar.length || parcalar.some(parca => !Number.isFinite(parca))) return null;
  if (parcalar.length === 1) return parcalar[0];
  if (parcalar.length === 2) return parcalar[0] * 60 + parcalar[1];
  if (parcalar.length === 3) return parcalar[0] * 3600 + parcalar[1] * 60 + parcalar[2];
  return null;
}

function duzenlemeAraliginiGuncelle() {
  const baslangicKaydiraci = document.getElementById('baslangicKaydiraci');
  const bitisKaydiraci = document.getElementById('bitisKaydiraci');
  if (!baslangicKaydiraci || !bitisKaydiraci) return;
  duzenlemeBaslangic = Math.max(0, Math.min(Number(baslangicKaydiraci.value), duzenlemeSure));
  duzenlemeBitis = Math.max(0, Math.min(Number(bitisKaydiraci.value), duzenlemeSure));
  if (duzenlemeBaslangic >= duzenlemeBitis) {
    if (document.activeElement === baslangicKaydiraci) {
      duzenlemeBaslangic = Math.max(0, duzenlemeBitis - 0.1);
      baslangicKaydiraci.value = String(duzenlemeBaslangic);
    } else {
      duzenlemeBitis = Math.min(duzenlemeSure, duzenlemeBaslangic + 0.1);
      bitisKaydiraci.value = String(duzenlemeBitis);
    }
  }
  document.getElementById('baslangicZamani').value = zamanMetni(duzenlemeBaslangic);
  document.getElementById('bitisZamani').value = zamanMetni(duzenlemeBitis);
  document.getElementById('baslangicEtiketi').textContent = zamanMetni(duzenlemeBaslangic);
  document.getElementById('bitisEtiketi').textContent = zamanMetni(duzenlemeBitis);
  document.getElementById('seciliSureEtiketi').textContent = `Seçim: ${zamanMetni(duzenlemeBitis - duzenlemeBaslangic)}`;
  const seciliTimeline = document.getElementById('timelineSecili');
  const sol = duzenlemeSure ? (duzenlemeBaslangic / duzenlemeSure) * 100 : 0;
  const genislik = duzenlemeSure ? ((duzenlemeBitis - duzenlemeBaslangic) / duzenlemeSure) * 100 : 0;
  seciliTimeline.style.left = `${sol}%`;
  seciliTimeline.style.width = `${Math.max(0, genislik)}%`;
  document.getElementById('baslangicKareZamani').textContent = zamanMetni(duzenlemeBaslangic);
  document.getElementById('bitisKareZamani').textContent = zamanMetni(duzenlemeBitis);
  kareleriGuncellemePlanla();
  document.getElementById('indirLink').innerHTML = '';
}

function kareleriGuncellemePlanla() {
  clearTimeout(kareGuncellemeZamani);
  kareGuncellemeZamani = setTimeout(() => duzenlemeKareleriniGuncelle(), 140);
}

function videoKonumunaGit(video, saniye) {
  return new Promise(resolve => {
    const hedef = Math.max(0, Math.min(saniye, video.duration || saniye));
    let tamamlandi = false;
    let kareBekleniyor = false;
    let zamanAsimi;
    const kareyiBekle = () => {
      if (kareBekleniyor) return;
      kareBekleniyor = true;
      let kareHazir = false;
      const tamamla = () => {
        if (kareHazir) return;
        kareHazir = true;
        resolve();
      };
      if (typeof video.requestVideoFrameCallback === 'function') video.requestVideoFrameCallback(tamamla);
      requestAnimationFrame(() => requestAnimationFrame(tamamla));
      setTimeout(tamamla, 120);
    };
    const bitir = () => {
      if (tamamlandi) return;
      tamamlandi = true;
      clearTimeout(zamanAsimi);
      video.removeEventListener('seeked', bitir);
      kareyiBekle();
    };
    video.addEventListener('seeked', bitir, { once: true });
    if (Math.abs(video.currentTime - hedef) < 0.05) {
      bitir();
    } else {
      video.currentTime = hedef;
      zamanAsimi = setTimeout(bitir, 2000);
    }
  });
}

async function duzenlemeKareleriniGuncelle() {
  const video = document.getElementById('kareVideo');
  if (!duzenlemeAktif || !video) return;
  if (video.readyState < 2 || !video.videoWidth) {
    clearTimeout(kareGuncellemeZamani);
    kareGuncellemeZamani = setTimeout(() => duzenlemeKareleriniGuncelle(), 250);
    return;
  }
  const sayac = ++kareGuncellemeSayaci;
  video.pause();
  const canvas = document.createElement('canvas');
  const oran = Math.min(1, 640 / video.videoWidth);
  canvas.width = Math.max(1, Math.round(video.videoWidth * oran));
  canvas.height = Math.max(1, Math.round(video.videoHeight * oran));
  const context = canvas.getContext('2d');
  try {
    await videoKonumunaGit(video, duzenlemeBaslangic);
    if (sayac !== kareGuncellemeSayaci) return;
    context.drawImage(video, 0, 0, canvas.width, canvas.height);
    document.getElementById('baslangicKaresi').src = canvas.toDataURL('image/jpeg', 0.82);
    await videoKonumunaGit(video, duzenlemeBitis);
    if (sayac !== kareGuncellemeSayaci) return;
    context.drawImage(video, 0, 0, canvas.width, canvas.height);
    document.getElementById('bitisKaresi').src = canvas.toDataURL('image/jpeg', 0.82);
  } catch {}
}

function duzenlemeZamanAlaniniUygula(inputId, kaydiracId) {
  const input = document.getElementById(inputId);
  const saniye = zamanSayisi(input.value);
  if (saniye === null) {
    input.value = zamanMetni(inputId === 'baslangicZamani' ? duzenlemeBaslangic : duzenlemeBitis);
    return;
  }
  const kaydirac = document.getElementById(kaydiracId);
  kaydirac.value = String(Math.max(0, Math.min(saniye, duzenlemeSure)));
  duzenlemeAraliginiGuncelle();
}

function duzenlemeOnizlemesiniKapat() {
  const video = document.getElementById('duzenlemeVideo');
  const kareVideo = document.getElementById('kareVideo');
  clearTimeout(kareGuncellemeZamani);
  kareGuncellemeZamani = null;
  video.pause();
  video.removeAttribute('src');
  video.load();
  kareVideo.pause();
  kareVideo.removeAttribute('src');
  kareVideo.load();
  kareGuncellemeSayaci++;
  document.getElementById('baslangicKaresi').removeAttribute('src');
  document.getElementById('bitisKaresi').removeAttribute('src');
  document.getElementById('duzenlemePanel').classList.remove('aktif');
  document.getElementById('sesFormatBaslik').hidden = false;
  document.getElementById('sesFormatlar').hidden = false;
  document.getElementById('videoFormatBaslik').textContent = 'Video Formatları';
  const duzenleBtn = document.getElementById('duzenleBtn');
  duzenleBtn.innerHTML = '<span id="duzenleBtnIcerik"><i class="bi bi-scissors"></i> Videoyu düzenle</span>';
  duzenleBtn.removeAttribute('aria-busy');
  duzenlemeAktif = false;
}

async function duzenlemeAc() {
  if (duzenlemeAktif) return duzenlemeOnizlemesiniKapat();
  const url = document.getElementById('urlGiris').value.trim();
  if (!url) return mesajGoster('hata', 'Önce bir video analiz edin.');
  const btn = document.getElementById('duzenleBtn');
  btn.disabled = true;
  btn.setAttribute('aria-busy', 'true');
  btn.innerHTML = '<span class="duzenle-progress" aria-hidden="true"><span></span></span><span id="duzenleBtnIcerik">Video hazırlanıyor...</span>';
  mesajGoster('bilgi', 'Video önizlemesi hazırlanıyor...');
  try {
    const yanit = await fetch('/indir/onizleme', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, baslik: analizVeri?.baslik || '' })
    });
    const veri = await yanit.json();
    if (!veri.basari) throw new Error(veri.mesaj || 'Önizleme hazırlanamadı.');
    duzenlemeOnizlemeId = veri.onizlemeId;
    duzenlemeUrl = url;
    const panel = document.getElementById('duzenlemePanel');
    panel.classList.add('aktif');
    const video = document.getElementById('duzenlemeVideo');
    video.src = `/indir/onizleme/${encodeURIComponent(duzenlemeOnizlemeId)}`;
    const kareVideo = document.getElementById('kareVideo');
    kareVideo.src = video.src;
    document.getElementById('sesFormatBaslik').hidden = true;
    document.getElementById('sesFormatlar').hidden = true;
    document.getElementById('videoFormatBaslik').textContent = 'Kırpılmış video kalitesi';
    btn.innerHTML = '<span id="duzenleBtnIcerik">Düzenleyiciyi kapat</span>';
    btn.removeAttribute('aria-busy');
    duzenlemeAktif = true;
    mesajGizle();
  } catch (hata) {
    mesajGoster('hata', hata.message || 'Önizleme hazırlanamadı.');
  } finally {
    btn.disabled = false;
    if (!duzenlemeAktif) {
      btn.innerHTML = '<span id="duzenleBtnIcerik"><i class="bi bi-scissors"></i> Videoyu düzenle</span>';
      btn.removeAttribute('aria-busy');
    }
  }
}

function duzenlemeVideoHazir() {
  const video = document.getElementById('duzenlemeVideo');
  duzenlemeSure = Number(video.duration || 0);
  if (!duzenlemeSure) return;
  duzenlemeBaslangic = 0;
  duzenlemeBitis = Math.min(duzenlemeSure, 1800);
  ['baslangicKaydiraci', 'bitisKaydiraci'].forEach(id => {
    const kaydirac = document.getElementById(id);
    kaydirac.max = String(duzenlemeSure);
  });
  document.getElementById('baslangicKaydiraci').value = '0';
  document.getElementById('bitisKaydiraci').value = String(duzenlemeSure);
  duzenlemeAraliginiGuncelle();
}

async function kirpilmisVideoIndir() {
  if (seciliFormat.format !== 'mp4') return mesajGoster('hata', 'Kırpma yalnızca MP4 formatında kullanılabilir.');
  if (!duzenlemeUrl || !duzenlemeSure) return mesajGoster('hata', 'Önizleme henüz hazır değil.');
  if (duzenlemeBitis - duzenlemeBaslangic > 1800) return mesajGoster('hata', 'En fazla 30 dakikalık klip oluşturabilirsiniz.');
  const btn = document.getElementById('indirBtn');
  btn.disabled = true;
  indirmeIlerlemesiGoster('Video hazırlanıyor ve kırpılıyor...', 15);
  btn.innerHTML = '<span class="yukleniyor"></span> Klip hazırlanıyor...';
  mesajGoster('bilgi', 'Klip hazırlanıyor. Bu işlem videonun uzunluğuna göre sürebilir...');
  document.getElementById('indirLink').innerHTML = '';
  try {
    const yanit = await fetch('/indir/kirp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        url: duzenlemeUrl,
        baslangic: duzenlemeBaslangic,
        bitis: duzenlemeBitis,
        kalite: seciliFormat.kalite,
        baslik: analizVeri?.baslik || ''
      })
    });
    const veri = await yanit.json();
    if (!veri.basari) return mesajGoster('hata', veri.mesaj || 'Klip oluşturulamadı.');
    indirmeIlerlemesiGoster('Kırpılmış video hazır.', 100, 'tamamlandi');
    mesajGoster('basari', 'Kırpılmış videonuz hazır.');
    document.getElementById('indirLink').innerHTML =
      `<a class="indir-link-btn" href="/indir/dosya/${veri.indirmeId}/${veri.format}?ad=${encodeURIComponent(veri.dosyaAdi || 'nodeapp')}" download><i class="bi bi-download"></i> Kırpılmış videoyu indir</a>`;
  } catch {
    indirmeIlerlemesiGoster('İndirme sırasında bağlantı hatası oluştu.', 0, 'hata');
    mesajGoster('hata', 'Sunucu ile bağlantı kurulamadı.');
  } finally {
    btn.disabled = false;
    btn.innerHTML = `<span><i class="bi bi-download"></i></span> MP4${seciliFormat.kalite ? ' · ' + seciliFormat.kalite : ''} Kırpılmış videoyu indir`;
  }
}

async function analizBaslat() {
  const url = document.getElementById('urlGiris').value.trim();
  if (!url) return mesajGoster('hata', 'Lütfen bir bağlantı girin.');

  const btn = document.getElementById('analizBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="yukleniyor"></span>';
  mesajGizle();
  if (duzenlemeAktif) duzenlemeOnizlemesiniKapat();
  duzenlemeOnizlemeId = null;
  duzenlemeUrl = '';
  document.getElementById('duzenleBtn').classList.remove('aktif');
  document.getElementById('sonucAlani').classList.remove('aktif');
  document.getElementById('indirLink').innerHTML = '';

  try {
    const yanit = await fetch('/indir/analiz', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url })
    });
    const veri = await yanit.json();

    if (!veri.basari) {
      mesajGoster('hata', veri.mesaj || 'Analiz başarısız.');
    } else {
      oynatmaModu = veri.veri.tur === 'oynatma_listesi';
      oynatmaVeri = oynatmaModu ? veri.veri : null;
      analizVeri = veri.veri;
      document.getElementById('duzenleBtn').classList.toggle('aktif', !oynatmaModu);
      goruntulemedyaBilgi(veri.veri);
      document.getElementById('oynatmaPanel').hidden = !oynatmaModu;
      if (oynatmaModu) {
        oynatmaListesiGoster(veri.veri);
        document.getElementById('sonucAlani').classList.add('aktif');
        varsayilanFormatlariGoster();
        const ilkVideo = veri.veri.oynatmaListesi?.[0];
        if (!ilkVideo) throw new Error('Oynatma listesinde video bulunamadi');
        try {
          await oynatmaFormatlariniAl(ilkVideo.url);
        } catch {
          mesajGoster('bilgi', 'Liste hazır. Kaynağa göre kullanılabilen genel format seçenekleri gösteriliyor.');
        }
      } else {
        goruntuleFormatlar(veri.veri.formatlar || []);
        document.getElementById('sonucAlani').classList.add('aktif');
      }
    }
  } catch {
    mesajGoster('hata', 'Sunucu ile bağlantı kurulamadı.');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Analiz Et';
  }
}

function goruntulemedyaBilgi(veri) {
  const sn = veri.sure;
  const sure = sn ? Math.floor(sn/60) + ':' + String(sn%60).padStart(2,'0') : '';
  document.getElementById('medyaBilgi').innerHTML = `
    ${veri.kucukResim ? `<img src="${veri.kucukResim}" alt="önizleme" class="medya-onizleme">` : ''}
    <div class="medya-bilgi-yazi">
      <h3>${escHtml(veri.baslik)}</h3>
      <div class="meta">
        <span class="platform-rozet">${escHtml(veri.platform.ad)}</span>
        ${sure ? `<span><i class="bi bi-clock"></i> ${sure}</span>` : ''}
      </div>
    </div>`;
}

function goruntuleFormatlar(formatlar) {
  const video = formatlar.filter(f => f.tur === 'video');
  const ses = formatlar.filter(f => f.tur === 'ses');
  const videoAlani = document.getElementById('videoFormatlar');
  const sesAlani = document.getElementById('sesFormatlar');

  videoAlani.innerHTML = video.map(f =>
    `<button class="format-kart" type="button" data-format="mp4" data-kalite="${f.kalite}" data-tur="video">
      <div class="format-ad">MP4</div>
      <div class="format-tur">${f.kalite}</div>
    </button>`).join('') || '<p style="color:var(--yazi2);font-size:14px">Video formatı bulunamadı.</p>';

  sesAlani.innerHTML = ses.map(f =>
    `<button class="format-kart" type="button" data-format="${f.format}" data-kalite="" data-tur="ses">
      <div class="format-ad">${f.format.toUpperCase()}</div>
      <div class="format-tur">Ses</div>
    </button>`).join('');

  [...videoAlani.querySelectorAll('.format-kart'), ...sesAlani.querySelectorAll('.format-kart')].forEach(kart => {
    kart.addEventListener('click', () => formatKartTiklandi(kart));
  });
}

function formatKartTiklandi(el) {
  formatSec(el, el.dataset.format, el.dataset.kalite || '', el.dataset.tur);
}

function formatSec(el, format, kalite, tur) {
  if (duzenlemeAktif && format !== 'mp4') {
    return mesajGoster('bilgi', 'Düzenleme yalnızca MP4 formatında kullanılabilir.');
  }
  document.querySelectorAll('.format-kart').forEach(k => k.classList.remove('secili'));
  el.classList.add('secili');
  seciliFormat.format = format;
  seciliFormat.kalite = kalite;
  seciliFormat.tur = tur;
  const btn = document.getElementById('indirBtn');
  btn.disabled = false;
  indirmeIlerlemesiSifirla();
  btn.innerHTML = `<span><i class="bi bi-download"></i></span> ${format.toUpperCase()}${kalite ? ' · ' + kalite : ''} ${duzenlemeAktif ? 'Kırpılmış videoyu indir' : (oynatmaModu ? 'Seçilenleri İndir' : 'İndir')}`;
  document.getElementById('indirLink').innerHTML = '';
}

async function indirmeBaslat() {
  if (!seciliFormat.format) return;
  if (duzenlemeAktif) return kirpilmisVideoIndir();
  if (oynatmaModu) return topluIndirmeBaslat();
  const url = document.getElementById('urlGiris').value.trim();
  const btn = document.getElementById('indirBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="yukleniyor"></span> İndiriliyor...';
  
  indirmeIlerlemesiGoster('Sunucuya bağlanıyor...', 5);
  mesajGoster('bilgi', 'İndirme işlemi başlatıldı. Sunucu veriyi çekiyor...');
  document.getElementById('indirLink').innerHTML = '';

  try {
    const olayKaynagi = new EventSource(`/indir/canli-ilerleme?url=${encodeURIComponent(url)}&format=${seciliFormat.format}&kalite=${seciliFormat.kalite}`);

    olayKaynagi.onmessage = function(event) {
      try {
        const veri = JSON.parse(event.data);
        if (veri.yuzde) {
          indirmeIlerlemesiGoster(`Sunucuya indiriliyor: %${veri.yuzde}`, veri.yuzde);
        }
        if (veri.tamamlandi) {
          olayKaynagi.close();
          indirmeIlerlemesiGoster('İndirme tamamlandı. Dosyanız hazır.', 100, 'tamamlandi');
          mesajGoster('basari', 'Dosyanız hazır! Hemen aşağıdaki butona tıklayın.');
          document.getElementById('indirLink').innerHTML =
            `<a class="indir-link-btn" href="/indir/dosya/${veri.indirmeId}/${veri.format}?ad=${encodeURIComponent(veri.dosyaAdi || 'nodeapp')}" download>
              <i class="bi bi-download"></i> Dosyayı İndir (${veri.format.toUpperCase()})
            </a>`;
          btn.disabled = false;
          btn.innerHTML = `<span><i class="bi bi-download"></i></span> ${seciliFormat.format.toUpperCase()}${seciliFormat.kalite ? ' · ' + seciliFormat.kalite : ''} İndir`;
        }
        if (veri.hata) {
          olayKaynagi.close();
          indirmeIlerlemesiGoster('İndirme başarısız oldu.', 0, 'hata');
          mesajGoster('hata', veri.mesaj || 'İndirme başarısız.');
          btn.disabled = false;
          btn.innerHTML = `<span><i class="bi bi-download"></i></span> ${seciliFormat.format.toUpperCase()}${seciliFormat.kalite ? ' · ' + seciliFormat.kalite : ''} İndir`;
        }
      } catch (e) {}
    };

    olayKaynagi.onerror = function() {
      olayKaynagi.close();
      standartIndirIstegi(url, btn);
    };

  } catch {
    standartIndirIstegi(url, btn);
  }
}

async function standartIndirIstegi(url, btn) {
  try {
    indirmeIlerlemesiGoster('Dosya sunucuda işleniyor...', 40);
    const yanit = await fetch('/indir/baslat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, format: seciliFormat.format, kalite: seciliFormat.kalite, baslik: analizVeri?.baslik || '' })
    });
    const veri = await yanit.json();

    if (!veri.basari) {
      indirmeIlerlemesiGoster('İndirme başarısız oldu.', 0, 'hata');
      mesajGoster('hata', veri.mesaj || 'İndirme başarısız.');
    } else {
      indirmeIlerlemesiGoster('İndirme tamamlandı. Dosyanız hazır.', 100, 'tamamlandi');
      mesajGoster('basari', 'Dosyanız hazır! Hemen aşağıdaki butona tıklayın.');
      document.getElementById('indirLink').innerHTML =
        `<a class="indir-link-btn" href="/indir/dosya/${veri.indirmeId}/${veri.format}?ad=${encodeURIComponent(veri.dosyaAdi || 'nodeapp')}" download>
          <i class="bi bi-download"></i> Dosyayı İndir (${veri.format.toUpperCase()})
        </a>`;
    }
  } catch {
    indirmeIlerlemesiGoster('İndirme sırasında bağlantı hatası oluştu.', 0, 'hata');
    mesajGoster('hata', 'Sunucu ile bağlantı kurulamadı.');
  } finally {
    btn.disabled = false;
    btn.innerHTML = `<span><i class="bi bi-download"></i></span> ${seciliFormat.format.toUpperCase()}${seciliFormat.kalite ? ' · ' + seciliFormat.kalite : ''} İndir`;
  }
}

async function topluIndirmeBaslat() {
  const videolar = seciliOynatmaVideolari();
  if (!videolar.length) return mesajGoster('hata', 'Lütfen en az bir video seçin.');

  const btn = document.getElementById('indirBtn');
  btn.disabled = true;
  indirmeIlerlemesiGoster(`${videolar.length} video hazırlanıyor...`, 10);
  btn.innerHTML = '<span class="yukleniyor"></span> Seçilenler indiriliyor...';
  mesajGoster('bilgi', `${videolar.length} video indiriliyor. Bu işlem biraz sürebilir...`);
  document.getElementById('indirLink').innerHTML = '';

  try {
    const yanit = await fetch('/indir/toplu', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        videolar: videolar.map(video => ({ url: video.url, baslik: video.baslik })),
        format: seciliFormat.format,
        kalite: seciliFormat.kalite
      })
    });
    const veri = await yanit.json();
    if (!veri.basari) {
      indirmeIlerlemesiGoster('Toplu indirme başarısız oldu.', 0, 'hata');
      mesajGoster('hata', veri.mesaj || 'Toplu indirme başarısız.');
      return;
    }

    const basarili = (veri.sonuclar || []).filter(sonuc => sonuc.basari);
    const basarisiz = (veri.sonuclar || []).length - basarili.length;
    indirmeIlerlemesiGoster(`${basarili.length} video hazır${basarisiz ? `, ${basarisiz} video başarısız` : ''}.`, 100, basarisiz ? 'hata' : 'tamamlandi');
    mesajGoster(basarisiz ? 'bilgi' : 'basari', `${basarili.length} video hazır${basarisiz ? `, ${basarisiz} video indirilemedi` : ''}.`);
    document.getElementById('indirLink').innerHTML = `<div class="toplu-sonuclar">${basarili.map(sonuc => {
      const format = ['mp4', 'mp3', 'wav'].includes(sonuc.format) ? sonuc.format : 'mp4';
      const ad = String(sonuc.dosyaAdi || 'nodeapp').replace(/\.(mp4|mp3|wav)$/i, '');
      return `<a class="toplu-indirme-link" href="/indir/dosya/${encodeURIComponent(sonuc.indirmeId)}/${format}?ad=${encodeURIComponent(ad)}" data-dosya-adi="${escHtml(ad)}.${format}" download>
        <span>${escHtml(ad)}.${format}</span><span>İndir <i class="bi bi-download"></i></span>
      </a>`;
    }).join('')}</div>`;
    document.querySelectorAll('.toplu-indirme-link').forEach(link => {
      link.addEventListener('click', event => topluDosyaIndir(event, link));
    });
  } catch {
    indirmeIlerlemesiGoster('İndirme sırasında bağlantı hatası oluştu.', 0, 'hata');
    mesajGoster('hata', 'Sunucu ile bağlantı kurulamadı.');
  } finally {
    btn.disabled = false;
    btn.innerHTML = `<span><i class="bi bi-download"></i></span> ${seciliFormat.format.toUpperCase()}${seciliFormat.kalite ? ' · ' + seciliFormat.kalite : ''} Seçilenleri İndir`;
  }
}

async function topluDosyaIndir(event, link) {
  event.preventDefault();
  if (link.dataset.indiriliyor === 'true') return;
  link.dataset.indiriliyor = 'true';
  link.classList.add('yukleniyor');
  try {
    const yanit = await fetch(link.href, { headers: { Accept: 'audio/mpeg, audio/wav, video/mp4' } });
    const tip = (yanit.headers.get('content-type') || '').toLowerCase();
    if (!yanit.ok || tip.includes('text/html') || tip.includes('application/json')) {
      throw new Error('Dosya sunucuda bulunamadi');
    }
    const blob = await yanit.blob();
    const geciciUrl = URL.createObjectURL(blob);
    const indirme = document.createElement('a');
    indirme.href = geciciUrl;
    indirme.download = link.dataset.dosyaAdi || 'nodeapp.mp3';
    document.body.appendChild(indirme);
    indirme.click();
    indirme.remove();
    setTimeout(() => URL.revokeObjectURL(geciciUrl), 1000);
  } catch {
    mesajGoster('hata', 'Bu dosya hazir degil veya suresi dolmus. Lutfen toplu indirmeyi tekrar baslatin.');
  } finally {
    link.dataset.indiriliyor = 'false';
    link.classList.remove('yukleniyor');
  }
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

document.addEventListener('DOMContentLoaded', () => {
  const urlGiris = document.getElementById('urlGiris');
  const analizBtn = document.getElementById('analizBtn');
  const aramaGiris = document.getElementById('aramaGiris');
  const aramaBtn = document.getElementById('aramaBtn');
  const indirBtn = document.getElementById('indirBtn');
  const temaDugmesi = document.getElementById('temaDugmesi');
  const duzenlemeVideo = document.getElementById('duzenlemeVideo');
  const kareVideo = document.getElementById('kareVideo');

  temaDugmesi?.addEventListener('click', temaToggle);
  analizBtn?.addEventListener('click', analizBaslat);
  document.getElementById('baglantiSekmesi')?.addEventListener('click', () => sekmeDegistir('baglanti'));
  document.getElementById('aramaSekmesi')?.addEventListener('click', () => {
    aramaSecilen = false;
    sekmeDegistir('arama');
  });
  aramaBtn?.addEventListener('click', aramaBaslat);
  document.getElementById('aramaGeri')?.addEventListener('click', aramaSonuclarinaDon);
  document.getElementById('oynatmaTumunuSec')?.addEventListener('click', oynatmaTumunuDegistir);
  document.getElementById('duzenleBtn')?.addEventListener('click', duzenlemeAc);
  indirBtn?.addEventListener('click', indirmeBaslat);
  duzenlemeVideo?.addEventListener('loadedmetadata', duzenlemeVideoHazir);
  duzenlemeVideo?.addEventListener('loadeddata', kareleriGuncellemePlanla);
  duzenlemeVideo?.addEventListener('canplay', kareleriGuncellemePlanla);
  kareVideo?.addEventListener('loadeddata', kareleriGuncellemePlanla);
  kareVideo?.addEventListener('canplay', kareleriGuncellemePlanla);
  document.getElementById('baslangicKaydiraci')?.addEventListener('input', duzenlemeAraliginiGuncelle);
  document.getElementById('bitisKaydiraci')?.addEventListener('input', duzenlemeAraliginiGuncelle);
  document.getElementById('baslangicZamani')?.addEventListener('change', () => duzenlemeZamanAlaniniUygula('baslangicZamani', 'baslangicKaydiraci'));
  document.getElementById('bitisZamani')?.addEventListener('change', () => duzenlemeZamanAlaniniUygula('bitisZamani', 'bitisKaydiraci'));

  urlGiris?.addEventListener('keydown', e => {
    if (e.key === 'Enter') analizBaslat();
  });
  aramaGiris?.addEventListener('keydown', e => {
    if (e.key === 'Enter') aramaBaslat();
  });

  document.addEventListener('error', e => {
    if (e.target instanceof HTMLImageElement && e.target.classList.contains('medya-onizleme')) {
      e.target.style.display = 'none';
    }
  }, true);
});
</script>
</body>
</html>